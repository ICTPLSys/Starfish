# Hydra page-level RS(4,2) protection; no Starfish Design 2 planner.
# render_config.py replaces endpoint fields and scales client/Resident bytes
# from the application footprint while preserving this 80% Resident fraction.
server_count 7
server_addr 192.0.2.10
server_port 1893
server_addrs 192.0.2.10,192.0.2.10,192.0.2.10,192.0.2.10,192.0.2.10,192.0.2.10,192.0.2.10
server_ports 1893,1894,1895,1896,1897,1898,1899
ib_device_name mlx5_1
ib_port 1
server_buffer_size 17179869184
client_buffer_size 6442450944
evict_batch_size 65536
qp_count 1
max_thread_cnt 24
evacuate_thread_cnt 8
optimized_evacuator 1
mark_thread_cnt 2
enable_eager_evict 1
exclusive_cache 1
enable_selective_backup 0
remote_backup_mode greedy
remote_backup_budget_bytes 0
remote_backup_budget_pct 0
local_resident_budget_bytes 5153960755
enable_logical_object_profile 0
logical_object_profile_sample_shift 6
enable_resident_profile_planner 0
resident_profile_apply_plan 1
resident_profile_manual_trigger 0
resident_profile_stop_after_first_commit 0
resident_profile_warmup_ms 30000
resident_profile_sample_shift 6
resident_profile_group_bytes 262144
resident_profile_interval_ms 1000
resident_profile_initial_sample_windows 10
resident_profile_migration_hysteresis_pct 5
resident_profile_min_benefit_refs_per_replacement_object 0
resident_profile_write_weight 2
resident_profile_ema_decay_shift 1
resident_profile_migration_budget_pct 5
resident_profile_migration_budget_objects 0
enable_region_resident_placement 1
enable_region_hotness_placement 0
enable_region_fetch_hotness_placement 0
region_fetch_placement_policy design1_gain
region_fetch_resident_headroom_pct 1
region_fetch_plan_max_window_multiplier 16
region_fetch_min_reclassify_efficiency_pct 25
region_placement_bind_groups 0
ft_method hydra
ft_small_object_cutoff 4096
ft_small_stripe_shard_size_bytes 262144
ft_ec_data_shards 4
ft_ec_parity_shards 2
ft_standby_endpoint -1 # runner reserves endpoint 6 when seven endpoints are configured
evacuate_low_watermark_pct 20
