# Healthy-path Design 2 grouping and selective backup; no failure injection.
server_count 1
server_addr 192.0.2.10
server_port 1893
ib_device_name mlx5_1
server_buffer_size 12884901888
client_buffer_size 6738677767 # rendered from the application footprint and ratio
max_thread_cnt 24
exclusive_cache 1
ft_method ec_batch
remote_mapping stripe
stripe_size_bytes 1048576
ft_small_object_cutoff 4096
ft_small_stripe_shard_size_bytes 262144
ft_ec_data_shards 4
ft_ec_parity_shards 2
ft_standby_endpoint -1
enable_selective_backup 1
remote_backup_mode object_profiled
remote_backup_budget_pct 0
enable_logical_object_profile 1
logical_object_profile_sample_shift 6
enable_resident_profile_planner 1
resident_profile_require_work_phase 1
resident_profile_apply_plan 1
resident_profile_warmup_ms 30000
resident_profile_initial_sample_windows 10
resident_profile_min_benefit_refs_per_replacement_object 0
resident_profile_migration_budget_pct 5
enable_region_resident_placement 1
enable_region_hotness_placement 1
enable_region_fetch_hotness_placement 0
region_fetch_placement_policy design1_gain
region_placement_bind_groups 0
